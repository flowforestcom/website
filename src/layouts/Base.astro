---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Flowforest builds tools that serve one person well: local-first, portable, and independent of platforms.',
  canonical,
} = Astro.props;

const canonicalURL = canonical ? new URL(canonical, Astro.site) : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">
        <img src="/logo.png" alt="Flowforest" class="brand-mark" />
      </a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <slot name="footer">
        <span>&copy; <span id="year"></span> Flowforest</span>
      </slot>
    </footer>

    <script>
      const year = document.getElementById('year');
      if (year) year.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
