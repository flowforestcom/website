---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { getCollection, getEntry } from 'astro:content';
import '../styles/global.css';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing content entry: pages/home');

const sections = (await getCollection('sections')).sort(
  (a, b) => a.data.order - b.data.order,
);
const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title={page.data.title}
  description={page.data.description}
  canonical={page.data.canonical}
>
  {sections.map((section) => <Section section={section} products={products} />)}
</Base>

<script>
  import '../scripts/hero-contours.js';
</script>
