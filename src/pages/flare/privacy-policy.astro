---
import Base from '../../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import '../../styles/global.css';

const entry = await getEntry('pages', 'flare/privacy-policy');
if (!entry) throw new Error('Missing content entry: pages/flare/privacy-policy');

const { Content } = await render(entry);
const { title, description, canonical, heading, author, updated } = entry.data;
---

<Base title={title} description={description} canonical={canonical}>
  <div class="privacy-policy">
    <article>
      <h1>{heading ?? title}</h1>
      <p class="policy-updated">
        Built by {author ?? 'Flowforest'}{updated && <> · Updated {updated}</>}
      </p>
      <Content />
    </article>
  </div>

  <a slot="footer" href="/">Flowforest</a>
</Base>
